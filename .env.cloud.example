# Copy to .env.cloud and fill in. Never commit .env.cloud.
# Generate each secret with:  openssl rand -hex 32
APP_JWT_SECRET=replace-with-64-random-hex-characters
# Derives every branch's sync key. Changing it disconnects all branches (see docs/SYNC-RUNBOOK.md).
APP_CLOUD_MASTER_KEY=replace-with-64-random-hex-characters
CLOUD_DOMAIN=cloud.example.com

# Copy to .env and fill in. Never commit .env.
# Generate the secret with:  openssl rand -hex 32
APP_JWT_SECRET=replace-with-64-random-hex-characters
APP_ACCESS_TOKEN_MINUTES=720
SERVER_NAME=restaurant.local
# The server's address on the restaurant network (phones/tablets open https://<this-ip>/)
SERVER_IP=127.0.0.1
# Folder for off-site backup copies (USB disk / network share), e.g. D:\RestaurantBackups on Windows
# OFFSITE_PATH=./offsite
# Token for /api/v1/metrics monitoring (leave empty to disable)
APP_METRICS_TOKEN=

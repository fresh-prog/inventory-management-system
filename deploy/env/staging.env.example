# STAGING — a full copy of production settings with its OWN secrets and data.
# Never point staging at a production database or production cloud.
APP_ENV=production
APP_JWT_SECRET=<openssl rand -hex 32 — different from production>
APP_METRICS_TOKEN=<openssl rand -hex 24>
APP_ACCESS_TOKEN_MINUTES=720
SERVER_NAME=staging.restaurant.local
KL_IMAGE=ghcr.io/fresh-prog/inventory-management-system

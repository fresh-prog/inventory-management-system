# PRODUCTION (branch server). Secrets also live in ./secrets/*.txt (Docker secrets), never in git.
APP_ENV=production
APP_JWT_SECRET=<openssl rand -hex 32>
APP_METRICS_TOKEN=<openssl rand -hex 24>
APP_ACCESS_TOKEN_MINUTES=720
APP_MIN_FREE_MB=500
SERVER_NAME=restaurant.local
KL_IMAGE=ghcr.io/fresh-prog/inventory-management-system
OFFSITE_PATH=/mnt/offsite-backup
